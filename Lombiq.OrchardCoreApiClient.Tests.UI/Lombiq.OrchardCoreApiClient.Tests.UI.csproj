<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.OrchardCore.Tests.UI.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Lombiq.MSBuild.OrchardCore.Tests.UI.Sdk" Version="2.0.0" />

  <PropertyGroup>
    <Title>Lombiq API Client for Orchard Core - UI Test Extensions</Title>
    <CopyrightYear>2022</CopyrightYear>
    <DescriptionBody>Extensions to aid in UI testing Lombiq API Client for Orchard Core.</DescriptionBody>
    <PackageTags>OrchardCore;Lombiq;Refit;OpenId;ApiClient;UITesting;Testing;Automation</PackageTags>
    <RepositoryUrl>https://github.com/Lombiq/Orchard-Core-API-Client</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Lombiq/Orchard-Core-API-Client/blob/dev/Lombiq.OrchardCoreApiClient.Tests.UI/Readme.md</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Recipes\Lombiq.OrchardCoreApiClient.Tests.UI.OpenId.recipe.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Recipes\Lombiq.OrchardCoreApiClient.Tests.UI.OpenId.recipe.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lombiq.OrchardCoreApiClient\Lombiq.OrchardCoreApiClient.csproj" />
  </ItemGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../../Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.OrchardCore.Tests.UI.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Lombiq.MSBuild.OrchardCore.Tests.UI.Sdk" Version="2.0.0" />
</Project>
